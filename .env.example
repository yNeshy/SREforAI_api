# Application Configuration
APP_NAME=AI Cost Monitoring Platform
APP_VERSION=1.0.0
DEBUG=False

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/ai_cost_monitor

# Security Configuration
ENCRYPTION_KEY=your-fernet-encryption-key-at-least-32-characters-long
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# API Rate Limiting
OPENAI_RATE_LIMIT_REQUESTS_PER_MINUTE=3000
OPENAI_RATE_LIMIT_TOKENS_PER_MINUTE=200000
ANTHROPIC_RATE_LIMIT_REQUESTS_PER_MINUTE=1000
ANTHROPIC_RATE_LIMIT_TOKENS_PER_MINUTE=80000

# Retry Configuration
MAX_RETRIES=5
INITIAL_RETRY_DELAY_SECONDS=1.0
MAX_RETRY_DELAY_SECONDS=60.0
RETRY_EXPONENTIAL_BASE=2.0

# Timeout Configuration
REQUEST_TIMEOUT_SECONDS=30.0
CONNECTION_TIMEOUT_SECONDS=10.0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Ingestion Configuration
INGESTION_BATCH_SIZE_DAYS=1
INGESTION_LOOKBACK_DAYS=30
